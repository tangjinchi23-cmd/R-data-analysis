#| label: t1-02-na-check
stations_with_na <- weather_wide |>
filter(if_any(-c(Meteorological.Weather.Station, Month), is.na)) |>
distinct(Meteorological.Weather.Station)
stations_with_na
)
#| label: t1-02-na-check
stations_with_na <- weather_wide |>
filter(if_any(-c(Meteorological.Weather.Station, Month), is.na)) |>
distinct(Meteorological.Weather.Station)
stations_with_na
View(weather_wide)
na_by_station <- weather_wide |>
group_by(Meteorological.Weather.Station) |>
summarise(
na_count = sum(is.na(across(-c(Meteorological.Weather.Station, Month))))
)
na_by_station <- weather_wide |>
group_by(Meteorological.Weather.Station) |>
summarise(
na_count = sum(is.na(across(where(is.numeric))))
)
na_by_station
malin_head_data <- weather_wide |>
filter(Meteorological.Weather.Station == "Malin Head")
malin_head_data
malin_head_na_rows <- malin_head_data |>
filter(if_any(where(is.numeric), is.na))
malin_head_na_rows
